# Ignore aux and log files anywhere under files/
files/**/*.log
files/**/*.fls
files/**/*.fdb_latexmk
files/**/*.aux
files/**/*.gaux
files/**/*.gsnippet

# Maintenance tools, reports, and build archives stay local.
/tools/
/docs/
/collation/

# Reusable book build files and layout proofs stay local.
/build/
/books/lectern-sample.pdf
/books/pulpit-sample.pdf
/books/*.pdf.tmp
/print-edition/

# Python/macOS intermediates.
__pycache__/
*.py[cod]
.DS_Store
